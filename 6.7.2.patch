diff --git a/.github/workflows/test-matrix.yml b/.github/workflows/test-matrix.yml
new file mode 100644
index 0000000..2f95f6a
--- /dev/null
+++ b/.github/workflows/test-matrix.yml
@@ -0,0 +1,61 @@
+name: test-matrix
+
+on:
+  push:
+    branches:
+      - master
+      - "test-me-*"
+  pull_request:
+    branches:
+      - "*"
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - python-version: "3.9"
+            tox-env: "py39-pytestlatest"
+          - python-version: "3.10"
+            tox-env: "py310-pytestlatest"
+          - python-version: "3.11"
+            tox-env: "py311-pytestlatest"
+          - python-version: "3.12"
+            tox-env: "py312-pytestlatest"
+          - python-version: "3.13"
+            tox-env: "py313-pytestlatest"
+
+    steps:
+      - uses: actions/checkout@v6
+        with:
+          fetch-depth: 0
+
+      - name: Set up Python
+        uses: actions/setup-python@v6
+        with:
+          python-version: ${{ matrix.python-version }}
+
+      - name: Install tox
+        run: |
+          python -m pip install --upgrade pip
+          pip install tox
+
+      - name: Run tests
+        run: |
+          mkdir -p reports
+          tox run -e ${{ matrix.tox-env }} -- -n 4 --junitxml=reports/pytest-${{ matrix.python-version }}.xml
+
+      - name: Upload test report
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: pytest-report-py${{ matrix.python-version }}
+          path: reports/pytest-${{ matrix.python-version }}.xml
+          if-no-files-found: error
