+class WorkerType(enum.Enum):
+    """Worker 类型枚举"""
+    PROCESS = "process"
+    THREAD = "thread"
+    REMOTE = "remote"
+
+
+class Worker(ABC):
+    """Worker 基类，定义 Worker 的通用接口"""
+
+    @abstractmethod
+    def setup(self) -> None:
+        """设置 Worker"""
+        pass
+
+    @abstractmethod
+    def shutdown(self) -> None:
+        """关闭 Worker"""
+        pass
+
+    @abstractmethod
+    def ensure_teardown(self) -> None:
+        """确保 Worker 被关闭"""
+        pass
+
+    @abstractmethod
+    def sendcommand(self, name: str, **kwargs: object) -> None:
+        """发送命令给 Worker"""
+        pass
+
+
+class WorkerFactory(ABC):
+    """Worker 工厂基类，定义创建 Worker 的接口"""
+
+    @abstractmethod
+    def create_worker(
+        self,
+        nodemanager: NodeManager,
+        gateway: execnet.Gateway,
+        config: pytest.Config,
+        putevent: Callable[[tuple[str, dict[str, Any]]], None],
+    ) -> WorkerController:
+        """创建 Worker 实例"""
+        pass
+
+    @abstractmethod
+    def supports_spec(self, spec: execnet.XSpec) -> bool:
+        """判断该工厂是否支持指定的 spec"""
+        pass
+
+
+class ProcessWorkerFactory(WorkerFactory):
+    """进程 Worker 工厂"""
+
+    def create_worker(
+        self,
+        nodemanager: NodeManager,
+        gateway: execnet.Gateway,
+        config: pytest.Config,
+        putevent: Callable[[tuple[str, dict[str, Any]]], None],
+    ) -> WorkerController:
+        return WorkerController(nodemanager, gateway, config, putevent)
+
+    def supports_spec(self, spec: execnet.XSpec) -> bool:
+        return spec.popen is not None
+
+
+class ThreadWorkerFactory(WorkerFactory):
+    """线程 Worker 工厂"""
+
+    def create_worker(
+        self,
+        nodemanager: NodeManager,
+        gateway: execnet.Gateway,
+        config: pytest.Config,
+        putevent: Callable[[tuple[str, dict[str, Any]]], None],
+    ) -> WorkerController:
+        return WorkerController(nodemanager, gateway, config, putevent)
+
+    def supports_spec(self, spec: execnet.XSpec) -> bool:
+        return spec.popen is None and spec.chdir is None
+
+
+class RemoteWorkerFactory(WorkerFactory):
+    """远程 Worker 工厂"""
+
+    def create_worker(
+        self,
+        nodemanager: NodeManager,
+        gateway: execnet.Gateway,
+        config: pytest.Config,
+        putevent: Callable[[tuple[str, dict[str, Any]]], None],
+    ) -> WorkerController:
+        return WorkerController(nodemanager, gateway, config, putevent)
+
+    def supports_spec(self, spec: execnet.XSpec) -> bool:
+        return spec.popen is None and spec.chdir is not None
+
+
+class WorkerFactoryRegistry:
+    """Worker 工厂注册表，管理所有可用的 Worker 工厂"""
+
+    def __init__(self) -> None:
+        self._factories: list[WorkerFactory] = []
+        self._register_default_factories()
+
+    def _register_default_factories(self) -> None:
+        """注册默认的 Worker 工厂"""
+        self.register_factory(ProcessWorkerFactory())
+        self.register_factory(ThreadWorkerFactory())
+        self.register_factory(RemoteWorkerFactory())
+
+    def register_factory(self, factory: WorkerFactory) -> None:
+        """注册新的 Worker 工厂"""
+        self._factories.append(factory)
+
+    def get_factory(self, spec: execnet.XSpec) -> WorkerFactory:
+        """获取支持指定 spec 的 Worker 工厂"""
+        for factory in reversed(self._factories):
+            if factory.supports_spec(spec):
+                return factory
+        raise ValueError(f"No factory found for spec: {spec}")
+
