+class RemoteWorker:
+    """
+    RemoteWorker supports executing test cases on remote machines via SSH,
+    including connection pooling, heartbeat detection, and result transmission.
+    """
+
+    def __init__(self, host: str, pool_size: int = 3, heartbeat_interval: int = 5) -> None:
+        self.host = host
+        self.pool_size = pool_size
+        self.heartbeat_interval = heartbeat_interval
+        self._pool: queue.Queue[execnet.Gateway] = queue.Queue(maxsize=pool_size)
+        self._results: queue.Queue[dict[str, Any]] = queue.Queue()
+        self._running = True
+        self._heartbeat_thread = threading.Thread(target=self._heartbeat_loop, daemon=True)
+
+        self._initialize_pool()
+        self._heartbeat_thread.start()
+
+    def _initialize_pool(self) -> None:
+        for _ in range(self.pool_size):
+            gw = self._create_connection()
+            if gw:
+                self._pool.put(gw)
+
+    def _create_connection(self) -> execnet.Gateway | None:
+        try:
+            # Create a gateway via SSH using execnet
+            return execnet.makegateway(f"ssh={self.host}")
+        except Exception as e:
+            print(f"Failed to create SSH connection to {self.host}: {e}", file=sys.stderr)
+            return None
+
+    def _heartbeat_loop(self) -> None:
+        while self._running:
+            time.sleep(self.heartbeat_interval)
+            valid_gws = []
+            
+            # Check active connections
+            while not self._pool.empty():
+                try:
+                    gw = self._pool.get_nowait()
+                    if gw.hasreceiver():
+                        try:
+                            # Simple ping over execnet channel
+                            ch = gw.remote_exec("channel.send('pong')")
+                            if ch.receive(timeout=5) == 'pong':
+                                valid_gws.append(gw)
+                            else:
+                                gw.exit()
+                        except Exception:
+                            gw.exit()
+                    else:
+                        gw.exit()
+                except queue.Empty:
+                    break
+            
+            # Replenish pool
+            for gw in valid_gws:
+                self._pool.put(gw)
+                
+            while self._pool.qsize() < self.pool_size and self._running:
+                new_gw = self._create_connection()
+                if new_gw:
+                    self._pool.put(new_gw)
+
+    def execute_test(self, test_item: str) -> None:
+        """Execute a test case on the remote machine and collect results."""
+        try:
+            gw = self._pool.get(timeout=10)
+        except queue.Empty:
+            self._results.put({
+                "test": test_item,
+                "error": "No available connections in the pool",
+                "status": "failed",
+                "host": self.host
+            })
+            return
+
+        try:
+            # We send the test item to be executed remotely
+            channel = gw.remote_exec('''
+                import subprocess
+                test_item = channel.receive()
+                try:
+                    # Run the test case using pytest
+                    result = subprocess.check_output(
+                        ['pytest', test_item],
+                        text=True,
+                        stderr=subprocess.STDOUT
+                    )
+                    channel.send({"status": "success", "output": result})
+                except subprocess.CalledProcessError as e:
+                    channel.send({"status": "failed", "output": e.output})
+                except Exception as e:
+                    channel.send({"status": "error", "error": str(e)})
+            ''')
+            channel.send(test_item)
+            result = channel.receive()
+            result['test'] = test_item
+            result['host'] = self.host
+            self._results.put(result)
+        except Exception as e:
+            self._results.put({
+                "test": test_item,
+                "error": str(e),
+                "status": "error",
+                "host": self.host
+            })
+        finally:
+            self._pool.put(gw)
+
+    def get_results(self) -> list[dict[str, Any]]:
+        """Retrieve all test results."""
+        results = []
+        while not self._results.empty():
+            results.append(self._results.get())
+        return results
+
+    def close(self) -> None:
+        """Shutdown the worker and close all connections."""
+        self._running = False
+        self._heartbeat_thread.join(timeout=2)
+        while not self._pool.empty():
+            try:
+                gw = self._pool.get_nowait()
+                gw.exit()
+            except queue.Empty:
+                break
+
+
 if __name__ == "__channelexec__":
     channel: execnet.Channel = channel  # type: ignore[name-defined] # noqa: F821, PLW0127
     workerinput, args, option_dict, change_sys_path = channel.receive()  # type: ignore[name-defined]
