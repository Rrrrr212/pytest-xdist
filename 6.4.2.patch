+class WorkerFactory:
+    kind = "remote"
+
+    def prepare_spec(self, spec: execnet.XSpec, defaultchdir: str) -> execnet.XSpec:
+        if getattr(spec, "execmodel", None) != "main_thread_only":
+            spec = execnet.XSpec(f"execmodel=main_thread_only//{spec}")
+        return spec
+
+    def create_gateway(
+        self, group: execnet.Group, spec: execnet.XSpec
+    ) -> execnet.Gateway:
+        return group.makegateway(spec)
+
+    def create_controller(
+        self,
+        nodemanager: NodeManager,
+        gateway: execnet.Gateway,
+        config: pytest.Config,
+        putevent: WorkerEventQueue,
+    ) -> WorkerController:
+        return WorkerController(
+            nodemanager,
+            gateway,
+            config,
+            putevent,
+            worker_factory=self,
+        )
+
+    def remote_module(self) -> Any:
+        return xdist.remote
+
+    def should_make_relative_args(self, spec: execnet.XSpec) -> bool:
+        return not spec.popen or spec.chdir
+
+    def should_restore_sys_path(self, spec: execnet.XSpec) -> bool:
+        return spec.popen
+
+    def basetemp_name(self, gateway: execnet.Gateway) -> str:
+        return f"{self.kind}-{gateway.id}"
+
+
+class ProcessWorkerFactory(WorkerFactory):
+    kind = "process"
+
+
+class ThreadWorkerFactory(WorkerFactory):
+    kind = "thread"
+
+
+class RemoteWorkerFactory(WorkerFactory):
+    kind = "remote"
+
+    def prepare_spec(self, spec: execnet.XSpec, defaultchdir: str) -> execnet.XSpec:
+        spec = super().prepare_spec(spec, defaultchdir)
+        if not spec.chdir and not spec.popen:
+            spec.chdir = defaultchdir
+        return spec
+
+
+DEFAULT_WORKER_FACTORIES: tuple[WorkerFactory, ...] = (
+    ProcessWorkerFactory(),
+    ThreadWorkerFactory(),
+    RemoteWorkerFactory(),
+)
+DEFAULT_WORKER_FACTORY_MAP = {
+    factory.kind: factory for factory in DEFAULT_WORKER_FACTORIES
+}
+
+
+def _coerce_xspec(spec: execnet.XSpec | str) -> execnet.XSpec:
+    if isinstance(spec, execnet.XSpec):
+        return spec
+    return execnet.XSpec(spec)
+
+
+def _infer_worker_type(spec: execnet.XSpec) -> str:
+    worker_type = getattr(spec, "worker_type", None)
+    if worker_type is not None:
+        return worker_type
+    if spec.popen:
+        return "process"
+    return "remote"
+
